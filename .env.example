# Copy this file to .env and change the values for your machine.
# All values here are fake. Never put a real key in this file.
# Each setup step adds the keys that it needs.

# App
APP_ENV=local
LOG_LEVEL=info

# Database (Docker Compose, step 0.4)
POSTGRES_USER=seo_advisor
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=seo_advisor
DATABASE_URL=postgresql+psycopg://seo_advisor:local-only-change-me@localhost:5432/seo_advisor

# Web app (step 0.6)
VITE_API_BASE_URL=http://localhost:8000
