{
  "name": "api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed client for the seo-advisor API. src/schema.d.ts is generated: run `mise run gen-client`.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json --output src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  }
}
