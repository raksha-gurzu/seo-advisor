digraph G {
  graph [rankdir=TB fontname="Arial" nodesep=0.3 ranksep=0.45 splines=spline bgcolor="transparent"
         pad=0.15 newrank=true compound=true];
  node  [fontname="Arial" fontsize=12 margin="0.14,0.07"];
  edge  [fontname="Arial" fontsize=11 color="#5a6675" penwidth=1.4 arrowsize=0.75];
  subgraph cluster_people {
    label=<<B>People</B>> fontsize=11 fontcolor="#3b4654" labeljust=l
    style="rounded,dashed" color="#c9a96b" bgcolor="#fffaf0" margin=10
  U1 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Gurzu SEO team</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">pastes a URL, reviews<BR/>findings and suggestions</FONT></TD></TR></TABLE>> shape="box" style="rounded,filled,bold" fillcolor="#fff8e6" color="#8a5a00" penwidth=1.7];
  U2 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Client team</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">MyPipit: copies approved<BR/>text into its editor, saves</FONT></TD></TR></TABLE>> shape="box" style="rounded,filled,bold" fillcolor="#fff8e6" color="#8a5a00" penwidth=1.7];
  U3 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Expert reviewer (health)</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">extendmy.life, Phase 5</FONT></TD></TR></TABLE>> shape="box" style="filled,dashed" fillcolor="#f2f5f9" color="#7a8899" penwidth=1.7];
  }
  subgraph cluster_clients {
    label=<<B>Interfaces</B>> fontsize=11 fontcolor="#3b4654" labeljust=l
    style="rounded,dashed" color="#9fb3c8" bgcolor="#f7f9fb" margin=10
  WEB [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Web app</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">React + TypeScript:<BR/>analyse a page, findings,<BR/>suggestions</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  EXT [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Chrome extension (Phase 4)</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">fills the site editor<BR/>when a person accepts</FONT></TD></TR></TABLE>> shape="box" style="filled,dashed" fillcolor="#f2f5f9" color="#7a8899" penwidth=1.7];
  }
  subgraph cluster_core {
    label=<<B>seo-advisor service (Python, FastAPI)</B>> fontsize=11 fontcolor="#3b4654" labeljust=l
    style="rounded,dashed" color="#6941c6" bgcolor="#faf8ff" margin=10
  API [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>API</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">sites, pages, audit runs,<BR/>suggestions, reviews</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  FP [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Fetch one page</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">safe fetcher: SSRF guard,<BR/>robots.txt, rate limit</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  EX [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Extract</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">title, meta, headings,<BR/>images, links, structured<BR/>data, main text</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  AU [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Audit rules</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">rules per page type,<BR/>evidence and source</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  DR [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Suggest (DeepSeek)</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">fixes with [ADD: ...],<BR/>a person reviews</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  CK [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Checks</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">no invented facts,<BR/>no copied text</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#fde7e7" color="#b42318" penwidth=1.7];
  CR [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Crawler (Phase 3)</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">all pages of a site</FONT></TD></TR></TABLE>> shape="box" style="filled,dashed" fillcolor="#f2f5f9" color="#7a8899" penwidth=1.7];
  WF [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Schedules (Phase 3)</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">DBOS: daily, weekly,<BR/>monthly runs</FONT></TD></TR></TABLE>> shape="box" style="filled,dashed" fillcolor="#f2f5f9" color="#7a8899" penwidth=1.7];
  RP [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Reports (Phase 6)</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">outcomes, weekly report</FONT></TD></TR></TABLE>> shape="box" style="filled,dashed" fillcolor="#f2f5f9" color="#7a8899" penwidth=1.7];
    API -> AU [style=invis]; FP -> DR [style=invis]; EX -> CK [style=invis];
    AU -> CR [style=invis]; DR -> WF [style=invis]; CK -> RP [style=invis];
  }
  DB [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>PostgreSQL 18</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">sites, pages, snapshots,<BR/>audit runs, findings,<BR/>suggestions, AI call log</FONT></TD></TR></TABLE>> shape="cylinder" style="filled" fillcolor="#efe7fb" color="#6941c6" penwidth=1.7];
  subgraph cluster_data {
    label=<<B>Data sources (read-only)</B>> fontsize=11 fontcolor="#3b4654" labeljust=l
    style="rounded,dashed" color="#0b5cad" bgcolor="#f4f8fe" margin=10
  S1 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>One client page</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">a MyPipit blog post<BR/>(the URL that a person gives)</FONT></TD></TR></TABLE>> shape="note" style="filled" fillcolor="#ffffff" color="#475467" penwidth=1.7];
  S5 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>AI model</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">DeepSeek writes<BR/>suggestions</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#e4eefb" color="#0b5cad" penwidth=1.7];
  S2 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Later sources</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">Search Console (Phase 3),<BR/>CrUX, Bing Webmaster</FONT></TD></TR></TABLE>> shape="box" style="filled,dashed" fillcolor="#f2f5f9" color="#7a8899" penwidth=1.7];
  }
  U1 -> WEB [];
  U2 -> WEB [];
  U2 -> EXT [style="dashed"];
  U3 -> WEB [style="dashed"];
  WEB -> API [lhead="cluster_core"];
  EXT -> API [lhead="cluster_core" style="dashed"];
  CK -> DB [ltail="cluster_core"];
  DB -> S2 [lhead="cluster_data" style="invis"];
  FP -> S1 [ltail="cluster_core" lhead="cluster_data" label="read only"];
  { rank=same; U1; U2; U3; }
  { rank=same; WEB; EXT; }
  { rank=same; API; FP; EX; }
  { rank=same; AU; DR; CK; }
  { rank=same; CR; WF; RP; }
  { rank=same; S1; S5; S2; }
}
