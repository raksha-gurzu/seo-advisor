digraph G {
  graph [rankdir=TB fontname="Arial" nodesep=0.45 ranksep=0.34 splines=spline bgcolor="transparent"
         pad=0.15 newrank=true compound=true];
  node  [fontname="Arial" fontsize=12 margin="0.14,0.07"];
  edge  [fontname="Arial" fontsize=11 color="#5a6675" penwidth=1.4 arrowsize=0.75];
  F [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Finding on the page</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">from the audit run</FONT></TD></TR></TABLE>> shape="box" style="rounded,filled" fillcolor="#e3f4e8" color="#2e7d4f" penwidth=1.7];
  T [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Template or</B><BR/><B>this page?</B></TD></TR></TABLE>> shape="diamond" style="filled" fillcolor="#fff3d6" color="#c77700" margin="0.04" penwidth=1.7];
  TF [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Template fix request</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">to the site&#x27;s developers<BR/>(fixes all pages of a type)</FONT></TD></TR></TABLE>> shape="note" style="filled" fillcolor="#ffffff" color="#475467" penwidth=1.7];
  DR [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>AI suggestion (DeepSeek)</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">title, meta description, H1,<BR/>alt text, content notes</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  CK [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Checks</B><BR/><B>pass?</B></TD></TR></TABLE>> shape="diamond" style="filled" fillcolor="#fde7e7" color="#b42318" margin="0.04" penwidth=1.7];
  RW [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Rewrite once</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">or mark the sentence</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  R1 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Gurzu review</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">accept, edit or reject;<BR/>not the author</FONT></TD></TR></TABLE>> shape="box" style="rounded,filled,bold" fillcolor="#fff8e6" color="#8a5a00" penwidth=1.7];
  Y [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Expert or native review</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">health (YMYL) or German:<BR/>extendmy.life, Phase 5</FONT></TD></TR></TABLE>> shape="box" style="filled,dashed" fillcolor="#f2f5f9" color="#7a8899" penwidth=1.7];
  AP [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Copy into the site editor</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">a person saves;<BR/>extension in Phase 4</FONT></TD></TR></TABLE>> shape="box" style="rounded,filled,bold" fillcolor="#fff8e6" color="#8a5a00" penwidth=1.7];
  V [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Check the page again</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">Flow B</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  M [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Measure (Phase 6)</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">Search Console after<BR/>4, 8 and 12 weeks</FONT></TD></TR></TABLE>> shape="box" style="filled,dashed" fillcolor="#f2f5f9" color="#7a8899" penwidth=1.7];
  F -> T [];
  T -> TF [label=<<B> template </B>> fontcolor="#3b4654"];
  T -> DR [label=<<B> page </B>> fontcolor="#3b4654"];
  DR -> CK [];
  CK -> RW [label=<<B> No </B>> fontcolor="#b42318"];
  RW -> CK [];
  CK -> R1 [label=<<B> Yes </B>> fontcolor="#2e7d4f"];
  R1 -> AP [];
  R1 -> Y [style="dashed" label=<<B> later </B>> fontcolor="#3b4654"];
  Y -> AP [style="dashed"];
  AP -> V [];
  V -> M [style="dashed"];
  R1 -> DR [style="dashed" constraint="false" label=<<B> changes </B>> fontcolor="#3b4654"];
  { rank=same; T; TF; }
  { rank=same; CK; RW; }
  { rank=same; R1; Y; }
}
