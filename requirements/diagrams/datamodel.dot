digraph G {
  graph [rankdir=TB fontname="Arial" nodesep=0.3 ranksep=0.45 splines=spline bgcolor="transparent"
         pad=0.15 newrank=true compound=true];
  node  [fontname="Arial" fontsize=12 margin="0.14,0.07"];
  edge  [fontname="Arial" fontsize=11 color="#5a6675" penwidth=1.4 arrowsize=0.75];
  T1 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#344054"><TR><TD BGCOLOR="#e4e7ec"><B>tenants</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id (uuidv7)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">name</FONT></TD></TR></TABLE>>];
  T2 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#344054"><TR><TD BGCOLOR="#e4e7ec"><B>users</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tenant_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">email</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">role</FONT></TD></TR></TABLE>>];
  T3 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#344054"><TR><TD BGCOLOR="#e4e7ec"><B>sites</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tenant_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">base_url</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">languages</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">is_ymyl</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">gsc_property</FONT></TD></TR></TABLE>>];
  O1 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6941c6"><TR><TD BGCOLOR="#ece4fb"><B>schedules</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">site_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">kind, cron</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">next_run</FONT></TD></TR></TABLE>>];
  I1 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0b2a4a"><TR><TD BGCOLOR="#dbe7f5"><B>pages</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">site_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">url, language</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">page_type</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">hreflang_group</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD></TR></TABLE>>];
  A1 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#b42318"><TR><TD BGCOLOR="#fbe1de"><B>audit_runs</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">site_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">kind</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">code_version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">started, finished</FONT></TD></TR></TABLE>>];
  A3 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#b42318"><TR><TD BGCOLOR="#fbe1de"><B>rules</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">page_type, language</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">source</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">enabled</FONT></TD></TR></TABLE>>];
  G1 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0b5cad"><TR><TD BGCOLOR="#e1ecfb"><B>keywords</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">text</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">language, country</FONT></TD></TR></TABLE>>];
  G3 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0b5cad"><TR><TD BGCOLOR="#e1ecfb"><B>gsc_rows</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">site_id, date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">page, query</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">clicks, impressions</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ctr, position</FONT></TD></TR></TABLE>>];
  I2 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0b2a4a"><TR><TD BGCOLOR="#dbe7f5"><B>page_snapshots</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">page_id, fetched_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">http_status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">title, meta, h1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">canonical, hreflang</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">text_hash</FONT></TD></TR></TABLE>>];
  C1 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2e7d4f"><TR><TD BGCOLOR="#dcf2e3"><B>content_items</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">page_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">field</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">current_version_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">current_state</FONT></TD></TR></TABLE>>];
  A2 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#b42318"><TR><TD BGCOLOR="#fbe1de"><B>findings</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">run_id, page_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">rule_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">severity, evidence</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD></TR></TABLE>>];
  G2 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0b5cad"><TR><TD BGCOLOR="#e1ecfb"><B>keyword_page_map</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">keyword_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">page_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">role (primary/secondary)</FONT></TD></TR></TABLE>>];
  O3 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6941c6"><TR><TD BGCOLOR="#ece4fb"><B>outcomes</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">page_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">published_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">gsc_before, after_8w</FONT></TD></TR></TABLE>>];
  C2 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2e7d4f"><TR><TD BGCOLOR="#dcf2e3"><B>content_versions</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id, item_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">version_no</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">source (crawl/ai/human)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">body_jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">major_change</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">created_by, created_at</FONT></TD></TR></TABLE>>];
  C3 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2e7d4f"><TR><TD BGCOLOR="#dcf2e3"><B>content_state_events</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">item_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">from_state, to_state</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">actor, reason, created_at</FONT></TD></TR></TABLE>>];
  O2 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6941c6"><TR><TD BGCOLOR="#ece4fb"><B>llm_calls</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">job_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">model asked/returned</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">prompt_version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tokens, cost</FONT></TD></TR></TABLE>>];
  C4 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2e7d4f"><TR><TD BGCOLOR="#dcf2e3"><B>reviews</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">version_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">reviewer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">role (2i/expert/client)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">verdict, comment</FONT></TD></TR></TABLE>>];
  T1 -> T2 [arrowhead="crow"];
  T1 -> T3 [arrowhead="crow"];
  T3 -> O1 [arrowhead="crow"];
  T3 -> I1 [arrowhead="crow"];
  T3 -> A1 [arrowhead="crow"];
  T3 -> G3 [arrowhead="crow"];
  I1 -> I2 [arrowhead="crow"];
  I1 -> C1 [arrowhead="crow"];
  A1 -> A2 [arrowhead="crow"];
  A3 -> A2 [arrowhead="crow"];
  G1 -> G2 [arrowhead="crow"];
  I1 -> G2 [arrowhead="crow"];
  I1 -> O3 [arrowhead="crow"];
  C1 -> C2 [arrowhead="crow"];
  C1 -> C3 [arrowhead="crow"];
  C2 -> C4 [arrowhead="crow"];
  { rank=same; T1; T2; }
  { rank=same; T3; O1; }
  { rank=same; I1; A1; A3; G1; G3; }
  { rank=same; I2; C1; A2; G2; O3; }
  { rank=same; C2; C3; O2; }
}
