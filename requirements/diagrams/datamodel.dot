digraph G {
  graph [rankdir=TB fontname="Arial" nodesep=0.45 ranksep=0.5 splines=spline bgcolor="transparent"
         pad=0.15 newrank=true compound=true];
  node  [fontname="Arial" fontsize=12 margin="0.14,0.07"];
  edge  [fontname="Arial" fontsize=11 color="#5a6675" penwidth=1.4 arrowsize=0.75];
  T1 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#344054"><TR><TD BGCOLOR="#e4e7ec"><B>tenants</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id (uuidv7)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">name</FONT></TD></TR></TABLE>>];
  T3 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#344054"><TR><TD BGCOLOR="#e4e7ec"><B>sites</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tenant_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">base_url</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">language</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">page_types (rules)</FONT></TD></TR></TABLE>>];
  I1 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0b2a4a"><TR><TD BGCOLOR="#dbe7f5"><B>pages</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">site_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">url</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">page_type</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">(only pages that a</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">person analyses)</FONT></TD></TR></TABLE>>];
  I2 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0b2a4a"><TR><TD BGCOLOR="#dbe7f5"><B>page_snapshots</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">page_id, fetched_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">http_status, final_url</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">html (size limit)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">html_hash</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">extracted (JSONB)</FONT></TD></TR></TABLE>>];
  A1 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#b42318"><TR><TD BGCOLOR="#fbe1de"><B>audit_runs</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">page_id, snapshot_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">keyword</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">rules_version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">started, finished</FONT></TD></TR></TABLE>>];
  A2 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#b42318"><TR><TD BGCOLOR="#fbe1de"><B>findings</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">run_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">rule_id, severity</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">evidence: found,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">expected, selector</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">source, status</FONT></TD></TR></TABLE>>];
  C1 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2e7d4f"><TR><TD BGCOLOR="#dcf2e3"><B>suggestions</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">run_id, finding_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">field, text</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status (accepted,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">edited, rejected)</FONT></TD></TR></TABLE>>];
  O2 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6941c6"><TR><TD BGCOLOR="#ece4fb"><B>llm_calls</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">model</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">prompt_version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tokens, cost</FONT></TD></TR></TABLE>>];
  L1 [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7a8899"><TR><TD BGCOLOR="#f2f5f9"><B>later (Phase 3 to 6)</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">users, schedules</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">keywords, gsc_rows</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">keyword_page_map</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">content_items,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">content_versions,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">content_state_events,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">reviews, outcomes</FONT></TD></TR></TABLE>>];
  T1 -> T3 [arrowhead="crow"];
  T3 -> I1 [arrowhead="crow"];
  I1 -> I2 [arrowhead="crow"];
  I1 -> A1 [arrowhead="crow"];
  I2 -> A1 [arrowhead="crow"];
  A1 -> A2 [arrowhead="crow"];
  A1 -> C1 [arrowhead="crow"];
  A2 -> C1 [arrowhead="crow" style="dashed"];
  C1 -> O2 [arrowhead="crow" style="dashed"];
  { rank=same; T1; T3; L1; }
  { rank=same; I1; I2; }
  { rank=same; A1; A2; }
  { rank=same; C1; O2; }
}
