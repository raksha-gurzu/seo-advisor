digraph G {
  graph [rankdir=TB fontname="Arial" nodesep=0.5 ranksep=0.3 splines=spline bgcolor="transparent"
         pad=0.15 newrank=true compound=true];
  node  [fontname="Arial" fontsize=12 margin="0.14,0.07"];
  edge  [fontname="Arial" fontsize=11 color="#5a6675" penwidth=1.4 arrowsize=0.75];
  P0 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Phase 0: set up the repo</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">0.1 to 0.3 done; other steps<BR/>start when a slice needs them</FONT></TD></TR></TABLE>> shape="box" style="rounded,filled" fillcolor="#e3f4e8" color="#2e7d4f" penwidth=1.7];
  P1 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Phase 1: one page, end to end</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">MyPipit blog post: fetch, extract,<BR/>audit with evidence, DeepSeek<BR/>suggestions, review (slices 1 to 5)</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  G1 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>90% of findings</B><BR/><B>correct, 7 of 10</B><BR/><B>accepted?</B></TD></TR></TABLE>> shape="diamond" style="filled" fillcolor="#fde7e7" color="#b42318" margin="0.04" penwidth=1.7];
  P2 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Phase 2: more page types</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">listings, categories and<BR/>static pages on MyPipit</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  P3 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Phase 3: whole site</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">crawler, schedules, Search Console,<BR/>content workflow, work queue</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  G3 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Runs work for</B><BR/><B>2 weeks?</B></TD></TR></TABLE>> shape="diamond" style="filled" fillcolor="#fde7e7" color="#b42318" margin="0.04" penwidth=1.7];
  P4 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Phase 4: extension</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">fills the site editor;<BR/>a person saves</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  P5 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Phase 5: second site and languages</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">test site extendmy.life: EN + DE,<BR/>hreflang, native review, health rule</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  P6 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Phase 6: measure and report</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">outcomes, reports, alerts</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  PL [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Later</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">deployment with DevOps,<BR/>more sites, paid data</FONT></TD></TR></TABLE>> shape="box" style="filled,dashed" fillcolor="#f2f5f9" color="#7a8899" penwidth=1.7];
  FX [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Fix rules and prompts</B></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  P0 -> P1 [];
  P1 -> G1 [];
  G1 -> P2 [label=<<B> Yes </B>> fontcolor="#2e7d4f"];
  G1 -> FX [label=<<B> No </B>> fontcolor="#b42318"];
  FX -> P1 [];
  P2 -> P3 [];
  P3 -> G3 [];
  G3 -> P4 [label=<<B> Yes </B>> fontcolor="#2e7d4f"];
  G3 -> FX [label=<<B> No </B>> fontcolor="#b42318"];
  P4 -> P5 [];
  P5 -> P6 [];
  P6 -> PL [style="dashed"];
  { rank=same; G1; FX; }
}
