digraph G {
  graph [rankdir=TB fontname="Arial" nodesep=0.5 ranksep=0.4 splines=spline bgcolor="transparent"
         pad=0.15 newrank=true compound=true];
  node  [fontname="Arial" fontsize=12 margin="0.14,0.07"];
  edge  [fontname="Arial" fontsize=11 color="#5a6675" penwidth=1.4 arrowsize=0.75];
  T [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>A person asks for a new check</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">after the client saved a change</FONT></TD></TR></TABLE>> shape="box" style="rounded,filled,bold" fillcolor="#fff8e6" color="#8a5a00" penwidth=1.7];
  F [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Fetch the page again</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">new snapshot (same safe fetcher)</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  A [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Audit again</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">same rules version, same keyword</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  DF [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Compare with the last run</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">new, fixed and returning findings</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  Q [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>All findings</B><BR/><B>fixed?</B></TD></TR></TABLE>> shape="diamond" style="filled" fillcolor="#fff3d6" color="#c77700" margin="0.04" penwidth=1.7];
  OK [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Mark the page as done</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">keep both runs as history</FONT></TD></TR></TABLE>> shape="box" style="rounded,filled" fillcolor="#e3f4e8" color="#2e7d4f" penwidth=1.7];
  BK [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Back to suggestions</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">for the open findings</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  LT [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Phase 3: scheduled audits</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">DBOS runs daily, weekly and<BR/>monthly for the whole site</FONT></TD></TR></TABLE>> shape="box" style="filled,dashed" fillcolor="#f2f5f9" color="#7a8899" penwidth=1.7];
  T -> F [];
  F -> A [];
  A -> DF [];
  DF -> Q [];
  Q -> OK [label=<<B> Yes </B>> fontcolor="#2e7d4f"];
  Q -> BK [label=<<B> No </B>> fontcolor="#b42318"];
  LT -> F [style="dashed" label=<<B> later </B>> fontcolor="#3b4654"];
  { rank=same; T; LT; }
  { rank=same; OK; BK; }
}
