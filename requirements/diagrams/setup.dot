digraph G {
  graph [rankdir=TB fontname="Arial" nodesep=0.35 ranksep=0.34 splines=spline bgcolor="transparent"
         pad=0.15 newrank=true compound=true];
  node  [fontname="Arial" fontsize=12 margin="0.14,0.07"];
  edge  [fontname="Arial" fontsize=11 color="#5a6675" penwidth=1.4 arrowsize=0.75];
  A [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>0.1 Machine</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">mise, Docker, gh, Claude Code</FONT></TD></TR></TABLE>> shape="box" style="rounded,filled" fillcolor="#e3f4e8" color="#2e7d4f" penwidth=1.7];
  B [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>0.2 Repo skeleton</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">folders, README, mise.toml,<BR/>.env.example, NOTICE</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  subgraph cluster_base {
    label=<<B>Code bases (in parallel)</B>> fontsize=11 fontcolor="#3b4654" labeljust=l
    style="rounded,dashed" color="#9fb3c8" bgcolor="#f7f9fb" margin=10
  C1 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>0.3 Python</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">uv, ruff, mypy, pytest,<BR/>Settings</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  C2 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>0.4 Database</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">Compose, Alembic,<BR/>first migration, fixtures</FONT></TD></TR></TABLE>> shape="cylinder" style="filled" fillcolor="#efe7fb" color="#6941c6" penwidth=1.7];
  C3 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>0.5 API</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">FastAPI, errors, request ID,<BR/>logs, client generation</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  C4 [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>0.6 Web + extension</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">Vite, oxlint, Vitest, WXT</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  }
  D [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>0.7 Hooks</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">prek: hygiene, gitleaks,<BR/>format, lint</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#fde7e7" color="#b42318" penwidth=1.7];
  E [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>0.8 CI and GitHub</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">required check, ruleset,<BR/>Dependabot, PR template</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#fde7e7" color="#b42318" penwidth=1.7];
  F [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>0.9 Claude Code</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">CLAUDE.md, deny rules,<BR/>hooks, skills, reviewer</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#e6f6f4" color="#0f766e" penwidth=1.7];
  G [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>0.10 ADRs and diagrams</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">8 to 10 ADRs, C4 level 1 and 2</FONT></TD></TR></TABLE>> shape="note" style="filled" fillcolor="#ffffff" color="#475467" penwidth=1.7];
  H [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>0.11 Security and AI base</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">SSRF guard, AI layer,<BR/>recorded fixtures, 20 evals</FONT></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#fde7e7" color="#b42318" penwidth=1.7];
  Q [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>0.12 Fresh clone</B><BR/><B>check passes?</B></TD></TR></TABLE>> shape="diamond" style="filled" fillcolor="#fde7e7" color="#b42318" margin="0.04" penwidth=1.7];
  X [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Fix the setup</B></TD></TR></TABLE>> shape="box" style="filled" fillcolor="#ffffff" color="#0b2a4a" penwidth=1.7];
  Z [label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Start Phase 1</B></TD></TR><TR><TD><FONT POINT-SIZE="10" COLOR="#4a5565">feature work</FONT></TD></TR></TABLE>> shape="box" style="rounded,filled" fillcolor="#e3f4e8" color="#2e7d4f" penwidth=1.7];
  A -> B [];
  B -> C2 [lhead="cluster_base"];
  C3 -> D [ltail="cluster_base"];
  D -> E [];
  E -> F [];
  F -> G [];
  G -> H [];
  H -> Q [];
  Q -> Z [label=<<B> Yes </B>> fontcolor="#2e7d4f"];
  Q -> X [label=<<B> No </B>> fontcolor="#b42318"];
  X -> Q [];
  { rank=same; C1; C2; C3; C4; }
  { rank=same; Q; X; }
}
